# GrantAssist AI - Environment Variables
# Copy this file to .env and fill in your values

# ────────────────────────────────────────────
# Database (PostgreSQL / Supabase)
# ────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/grantassist

# ────────────────────────────────────────────
# Vector Database (Weaviate Cloud free tier)
# ────────────────────────────────────────────
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=

# ────────────────────────────────────────────
# Cache & Rate Limiting (Upstash Redis free tier)
# ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ────────────────────────────────────────────
# LLM Providers
# ────────────────────────────────────────────
# Primary: OpenRouter (free models available)
OPENROUTER_API_KEY=
# Fallback: Google AI Studio (free tier)
GOOGLE_AI_STUDIO_API_KEY=

# ────────────────────────────────────────────
# Email (SendGrid free tier - 100 emails/day)
# ────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@grantassist.ai

# ────────────────────────────────────────────
# Google Drive API (free 15GB storage)
# ────────────────────────────────────────────
GOOGLE_DRIVE_CREDENTIALS=

# ────────────────────────────────────────────
# Zotero API (free)
# ────────────────────────────────────────────
ZOTERO_API_KEY=

# ────────────────────────────────────────────
# Authentication (SuperTokens self-hosted)
# ────────────────────────────────────────────
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
SUPERTOKENS_API_KEY=

# ────────────────────────────────────────────
# Google Scholar (SerpApi free credits)
# ────────────────────────────────────────────
SERPAPI_API_KEY=

# ────────────────────────────────────────────
# Application
# ────────────────────────────────────────────
APP_NAME=GrantAssist AI
DEBUG=false
SECRET_KEY=change-me-in-production-use-a-random-string
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ────────────────────────────────────────────
# Deployment URLs
# ────────────────────────────────────────────
VERCEL_URL=
RENDER_URL=
